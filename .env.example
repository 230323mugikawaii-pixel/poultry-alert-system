APP_ENV=development
HOST=0.0.0.0
PORT=8080
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
PUBLIC_ORIGIN=http://127.0.0.1:5500
COOKIE_NAME=callnow_session
DATABASE_URL=postgresql://callnow:callnow@127.0.0.1:5432/callnow
AUTH_TOKEN_PEPPER=replace-with-at-least-32-random-characters
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/google/callback
GOOGLE_OAUTH_STATE_TTL_MINUTES=10
MICROSOFT_LOGIN_OAUTH_CLIENT_ID=
MICROSOFT_LOGIN_OAUTH_CLIENT_SECRET=
MICROSOFT_LOGIN_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/microsoft/callback
MICROSOFT_LOGIN_OAUTH_TENANT=common
MICROSOFT_LOGIN_OAUTH_STATE_TTL_MINUTES=10
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
APPLE_OAUTH_REDIRECT_URI=
APPLE_OAUTH_STATE_TTL_MINUTES=10
GMAIL_OAUTH_CLIENT_ID=replace-with-gmail-oauth-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-gmail-oauth-client-secret
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/gmail/callback
GMAIL_OAUTH_STATE_TTL_MINUTES=10
MICROSOFT_OAUTH_CLIENT_ID=replace-with-microsoft-oauth-client-id
MICROSOFT_OAUTH_CLIENT_SECRET=replace-with-microsoft-oauth-client-secret
MICROSOFT_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/mail/microsoft/callback
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_STATE_TTL_MINUTES=10
OWNER_ONBOARDING_TTL_HOURS=168
MAIL_TOKEN_ENCRYPTION_PROVIDER=local
MAIL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MAIL_TOKEN_ENCRYPTION_KEY_VERSION=local-development-v1
MAIL_KMS_KEY_NAME=
MAGIC_LINK_TTL_MINUTES=15
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
MAX_ACTIVE_SESSIONS=5
MAX_CONFIGURED_SEAT_COUNT=1000000
INVITATION_TTL_DAYS=30
JOIN_GRANT_TTL_MINUTES=15
LINE_LINK_TTL_HOURS=24
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Call Now <no-reply@call-now.local>
