generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LOCKED
  DELETED
}

enum CredentialType {
  PASSKEY
}

enum IdentityProvider {
  GOOGLE
  MICROSOFT
  APPLE
}

enum MailProvider {
  GOOGLE
  MICROSOFT
}

enum ChallengeKind {
  MAGIC_LINK
  GOOGLE_OAUTH
  MICROSOFT_OAUTH
  APPLE_OAUTH
  GMAIL_OAUTH
  MICROSOFT_MAIL_OAUTH
  PASSKEY_REGISTRATION
  PASSKEY_AUTHENTICATION
  JOIN_GRANT
  OWNER_TRANSFER
}

enum TeamStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionChangeStatus {
  AWAITING_PAYMENT
  PENDING_CAPACITY
  APPLIED
  CANCELED
  FAILED
}

enum InvitationKind {
  PASSWORD_CAPACITY
}

enum InvitationStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  REVOKED
  REPLACED
}

enum RedemptionStatus {
  STARTED
  COMPLETED
  REJECTED
}

enum NotificationChannel {
  WEB_PUSH
  EMAIL
}

enum NotificationTargetStatus {
  ACTIVE
  DISABLED
}

enum NotificationMemberStatus {
  ACTIVE
  DISABLED
}

enum UserNotificationType {
  OPERATOR_ANNOUNCEMENT
  SYSTEM
  FEEDBACK_REPLY
}

enum FeedbackStatus {
  SUBMITTED
  REPLIED
  CLOSED
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum AlertRecipientKind {
  OWNER
  NOTIFICATION_MEMBER
}

enum AlertDeliveryChannel {
  IN_APP
}

enum AlertRecipientStatus {
  PENDING
  ACKNOWLEDGED
  CLOSED
}

enum MailConnectionStatus {
  ACTIVE
  PAUSED
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum MailAuthorizationStatus {
  ACTIVE
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum OwnerOnboardingStatus {
  PENDING
  PURCHASED
  COMPLETED
  EXPIRED
  ABANDONED
}

enum OnboardingMailChoiceStatus {
  AUTHORIZED
  ACTIVATED
  DEFERRED
  SKIPPED
}

enum OwnerTransferStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  email                   String                 @unique @db.VarChar(320)
  displayName             String?                @db.VarChar(120)
  status                  UserStatus             @default(ACTIVE)
  emailVerifiedAt         DateTime?              @db.Timestamptz(3)
  lockedUntil             DateTime?              @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt               DateTime?              @db.Timestamptz(3)
  credentials             AuthCredential[]
  externalIdentities      ExternalIdentity[]
  challenges              AuthChallenge[]
  sessions                Session[]
  devices                 Device[]
  memberships             TeamMembership[]
  removedMemberships      TeamMembership[]       @relation("MembershipRemover")
  requestedChanges        SubscriptionChange[]
  createdInvitations      Invitation[]
  redemptions             InvitationRedemption[]
  initiatedOwnerTransfers OwnerTransfer[]
  auditEvents             AuditEvent[]
  mailAuthorizations      MailAuthorization[]
  alertRecipients         AlertRecipient[]
  acknowledgedAlerts      Alert[]                @relation("AlertAcknowledgedByUser")
  ownerOnboarding         OwnerOnboarding?
  notifications           UserNotification[]
  feedbackSubmissions     FeedbackSubmission[]

  @@map("users")
}

model ExternalIdentity {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  provider        IdentityProvider
  providerSubject String           @db.VarChar(255)
  email           String           @db.VarChar(320)
  emailVerified   Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  lastUsedAt      DateTime?        @db.Timestamptz(3)
  revokedAt       DateTime?        @db.Timestamptz(3)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId, revokedAt])
  @@map("external_identities")
}

model AuthCredential {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  type           CredentialType
  credentialId   String?        @unique @db.VarChar(1024)
  publicKey      Bytes?
  signCount      BigInt?        @default(0)
  transports     String[]       @default([])
  label          String?        @db.VarChar(100)
  backupEligible Boolean?       @default(false)
  backupState    Boolean?       @default(false)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt     DateTime?      @db.Timestamptz(3)
  revokedAt      DateTime?      @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_credentials")
}

model AuthChallenge {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  kind         ChallengeKind
  email        String?       @db.VarChar(320)
  secretHash   String        @unique @db.Char(64)
  payload      Json?
  attemptCount Int           @default(0)
  maxAttempts  Int           @default(5)
  expiresAt    DateTime      @db.Timestamptz(3)
  consumedAt   DateTime?     @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, kind, createdAt])
  @@index([expiresAt])
  @@map("auth_challenges")
}

model Device {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @db.Uuid
  name                String?              @db.VarChar(120)
  userAgentHash       String?              @db.Char(64)
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  lastSeenAt          DateTime?            @db.Timestamptz(3)
  revokedAt           DateTime?            @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions            Session[]
  notificationTargets NotificationTarget[]

  @@index([userId, revokedAt])
  @@map("devices")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  deviceId      String?   @db.Uuid
  tokenHash     String    @unique @db.Char(64)
  ipHash        String?   @db.Char(64)
  userAgentHash String?   @db.Char(64)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @db.Timestamptz(3)
  idleExpiresAt DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  revokedAt     DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Team {
  id              String           @id @default(uuid()) @db.Uuid
  publicCode      String           @unique @db.Char(6)
  name            String?          @db.VarChar(120)
  status          TeamStatus       @default(ACTIVE)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  memberships     TeamMembership[]
  subscription    Subscription?
  keywords        TeamKeyword[]
  invitations     Invitation[]
  mailConnections MailConnection[]
  notificationMembers NotificationMember[]
  alerts          Alert[]
  ownerTransfers  OwnerTransfer[]
  auditEvents     AuditEvent[]
  ownerOnboarding OwnerOnboarding?
  feedbackSubmissions FeedbackSubmission[]

  @@map("teams")
}

model NotificationMember {
  id                String                      @id @default(uuid()) @db.Uuid
  teamId            String                      @db.Uuid
  callNowId         String                      @unique @db.VarChar(16)
  displayName       String?                     @db.VarChar(120)
  passwordHash      String                      @db.VarChar(255)
  status            NotificationMemberStatus    @default(ACTIVE)
  passwordUpdatedAt DateTime                    @default(now()) @db.Timestamptz(3)
  createdAt         DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                    @updatedAt @db.Timestamptz(3)
  disabledAt        DateTime?                   @db.Timestamptz(3)
  team              Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions          NotificationMemberSession[]
  alertRecipients    AlertRecipient[]
  acknowledgedAlerts Alert[]                     @relation("AlertAcknowledgedByNotificationMember")

  @@index([teamId, status])
  @@map("notification_members")
}

model NotificationMemberSession {
  id                   String             @id @default(uuid()) @db.Uuid
  notificationMemberId String             @db.Uuid
  tokenHash            String             @unique @db.Char(64)
  ipHash               String?            @db.Char(64)
  userAgentHash        String?            @db.Char(64)
  createdAt            DateTime           @default(now()) @db.Timestamptz(3)
  lastSeenAt           DateTime           @default(now()) @db.Timestamptz(3)
  idleExpiresAt        DateTime           @db.Timestamptz(3)
  expiresAt            DateTime           @db.Timestamptz(3)
  revokedAt            DateTime?          @db.Timestamptz(3)
  notificationMember   NotificationMember @relation(fields: [notificationMemberId], references: [id], onDelete: Cascade)

  @@index([notificationMemberId, revokedAt])
  @@index([expiresAt])
  @@map("notification_member_sessions")
}

model TeamMembership {
  id                  String                 @id @default(uuid()) @db.Uuid
  teamId              String                 @db.Uuid
  userId              String                 @db.Uuid
  role                MembershipRole
  status              MembershipStatus       @default(ACTIVE)
  joinedAt            DateTime               @default(now()) @db.Timestamptz(3)
  leftAt              DateTime?              @db.Timestamptz(3)
  removedAt           DateTime?              @db.Timestamptz(3)
  removedByUserId     String?                @db.Uuid
  team                Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  removedByUser       User?                  @relation("MembershipRemover", fields: [removedByUserId], references: [id], onDelete: SetNull)
  redemptions         InvitationRedemption[]
  notificationTargets NotificationTarget[]
  ownerTransferTarget OwnerTransfer[]

  @@unique([teamId, userId])
  @@index([teamId, role, status])
  @@map("team_memberships")
}

model Subscription {
  id                   String               @id @default(uuid()) @db.Uuid
  teamId               String               @unique @db.Uuid
  status               SubscriptionStatus   @default(ACTIVE)
  seatLimit            Int                  @default(0)
  pendingSeatLimit     Int?
  currentTermAmountYen Int                  @default(6000)
  currentTermStartedAt DateTime             @db.Timestamptz(3)
  currentTermEndsAt    DateTime             @db.Timestamptz(3)
  pricingVersion       String               @default("2026-08") @db.VarChar(32)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  team                 Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  changes              SubscriptionChange[]

  @@map("subscriptions")
}

model SubscriptionChange {
  id                 String                   @id @default(uuid()) @db.Uuid
  subscriptionId     String                   @db.Uuid
  requestedByUserId  String                   @db.Uuid
  previousSeatLimit  Int
  requestedSeatLimit Int
  status             SubscriptionChangeStatus
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  appliedAt          DateTime?                @db.Timestamptz(3)
  canceledAt         DateTime?                @db.Timestamptz(3)
  paymentEventId     String?                  @unique @db.VarChar(191)
  issuedInvitationId String?                  @unique @db.Uuid
  subscription       Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  requestedByUser    User                     @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  issuedInvitation   Invitation?              @relation("SeatIncreaseInvitation", fields: [issuedInvitationId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, status])
  @@map("subscription_changes")
}

model TeamKeyword {
  id         String   @id @default(uuid()) @db.Uuid
  teamId     String   @db.Uuid
  keyword    String   @db.VarChar(100)
  normalized String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, normalized])
  @@map("team_keywords")
}

model Invitation {
  id                 String                 @id @default(uuid()) @db.Uuid
  teamId             String                 @db.Uuid
  kind               InvitationKind         @default(PASSWORD_CAPACITY)
  status             InvitationStatus       @default(ACTIVE)
  passwordHash       String                 @db.VarChar(255)
  maxUses            Int
  usedCount          Int                    @default(0)
  expiresAt          DateTime               @db.Timestamptz(3)
  createdByUserId    String                 @db.Uuid
  replacedById       String?                @unique @db.Uuid
  invalidatedAt      DateTime?              @db.Timestamptz(3)
  invalidationNote   String?                @db.VarChar(120)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  team               Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser      User                   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  replacedBy         Invitation?            @relation("InvitationReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces           Invitation?            @relation("InvitationReplacement")
  links              InvitationLink[]
  redemptions        InvitationRedemption[]
  seatIncreaseChange SubscriptionChange?    @relation("SeatIncreaseInvitation")

  @@index([teamId, status])
  @@index([expiresAt])
  @@map("invitations")
}

model InvitationLink {
  id            String                 @id @default(uuid()) @db.Uuid
  invitationId  String                 @db.Uuid
  tokenHash     String                 @unique @db.Char(64)
  status        InvitationStatus       @default(ACTIVE)
  maxUses       Int                    @default(1)
  usedCount     Int                    @default(0)
  expiresAt     DateTime               @db.Timestamptz(3)
  invalidatedAt DateTime?              @db.Timestamptz(3)
  createdAt     DateTime               @default(now()) @db.Timestamptz(3)
  invitation    Invitation             @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  redemptions   InvitationRedemption[]

  @@index([invitationId, status])
  @@index([expiresAt])
  @@map("invitation_links")
}

model InvitationRedemption {
  id             String           @id @default(uuid()) @db.Uuid
  invitationId   String           @db.Uuid
  linkId         String?          @db.Uuid
  userId         String           @db.Uuid
  membershipId   String?          @db.Uuid
  status         RedemptionStatus @default(STARTED)
  idempotencyKey String           @unique @db.VarChar(100)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?        @db.Timestamptz(3)
  invitation     Invitation       @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  link           InvitationLink?  @relation(fields: [linkId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership     TeamMembership?  @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([invitationId, status])
  @@map("invitation_redemptions")
}

model NotificationTarget {
  id                 String                   @id @default(uuid()) @db.Uuid
  membershipId       String                   @db.Uuid
  deviceId           String?                  @db.Uuid
  channel            NotificationChannel
  status             NotificationTargetStatus @default(ACTIVE)
  endpointCiphertext String                   @db.Text
  endpointHash       String                   @db.Char(64)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  verifiedAt         DateTime?                @db.Timestamptz(3)
  disabledAt         DateTime?                @db.Timestamptz(3)
  membership         TeamMembership           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  device             Device?                  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([membershipId, channel, endpointHash])
  @@index([membershipId, status])
  @@map("notification_targets")
}

model MailAuthorization {
  id                    String                   @id @default(uuid()) @db.Uuid
  userId                String                   @db.Uuid
  provider              MailProvider             @default(GOOGLE)
  providerSubject       String                   @db.VarChar(255)
  email                 String                   @db.VarChar(320)
  encryptedRefreshToken String?                  @db.Text
  encryptionProvider    String?                  @db.VarChar(40)
  encryptionKeyVersion  String?                  @db.VarChar(255)
  grantedScopes         String[]                 @default([])
  status                MailAuthorizationStatus  @default(ACTIVE)
  lastVerifiedAt        DateTime?                @db.Timestamptz(3)
  revokedAt             DateTime?                @db.Timestamptz(3)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  connections           MailConnection[]
  onboardingChoices     OnboardingMailChoice[]

  @@unique([provider, providerSubject])
  @@index([userId, status, revokedAt])
  @@index([status, revokedAt])
  @@map("mail_authorizations")
}

model OwnerOnboarding {
  id          String                @id @default(uuid()) @db.Uuid
  userId      String                @unique @db.Uuid
  teamId      String?               @unique @db.Uuid
  status      OwnerOnboardingStatus @default(PENDING)
  seatCount   Int?
  keywords    String[]              @default([])
  expiresAt   DateTime              @db.Timestamptz(3)
  purchasedAt DateTime?             @db.Timestamptz(3)
  completedAt DateTime?             @db.Timestamptz(3)
  abandonedAt DateTime?             @db.Timestamptz(3)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  choices     OnboardingMailChoice[]

  @@index([status, expiresAt])
  @@map("owner_onboardings")
}

model OnboardingMailChoice {
  id                  String                       @id @default(uuid()) @db.Uuid
  onboardingId        String                       @db.Uuid
  provider            MailProvider
  mailAuthorizationId String?                      @db.Uuid
  status              OnboardingMailChoiceStatus
  keywords            String[]                     @default([])
  keywordsConfirmedAt DateTime?                    @db.Timestamptz(3)
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)
  onboarding          OwnerOnboarding              @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  mailAuthorization   MailAuthorization?           @relation(fields: [mailAuthorizationId], references: [id], onDelete: SetNull)

  @@unique([onboardingId, provider])
  @@index([mailAuthorizationId])
  @@map("onboarding_mail_choices")
}

model MailConnection {
  id                   String                @id @default(uuid()) @db.Uuid
  teamId               String                @db.Uuid
  mailAuthorizationId  String                @db.Uuid
  status               MailConnectionStatus  @default(ACTIVE)
  keywords             String[]              @default([])
  providerCursor       String?               @db.VarChar(2048)
  lastSyncAt           DateTime?             @db.Timestamptz(3)
  lastErrorCode        String?               @db.VarChar(100)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  revokedAt            DateTime?             @db.Timestamptz(3)
  team                 Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  mailAuthorization    MailAuthorization     @relation(fields: [mailAuthorizationId], references: [id], onDelete: Restrict)
  alerts               Alert[]

  @@unique([teamId, mailAuthorizationId])
  @@index([teamId, status])
  @@index([mailAuthorizationId, status])
  @@map("mail_connections")
}

model Alert {
  id                                 String              @id @default(uuid()) @db.Uuid
  teamId                             String              @db.Uuid
  sourceMailConnectionId             String              @db.Uuid
  sourceEventId                      String              @db.VarChar(191)
  status                             AlertStatus         @default(ACTIVE)
  detectedAt                         DateTime            @db.Timestamptz(3)
  matchedKeyword                     String              @db.VarChar(100)
  acknowledgedAt                     DateTime?           @db.Timestamptz(3)
  acknowledgedByUserId               String?             @db.Uuid
  acknowledgedByNotificationMemberId String?             @db.Uuid
  resolvedAt                         DateTime?           @db.Timestamptz(3)
  createdAt                          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                          DateTime            @updatedAt @db.Timestamptz(3)
  team                               Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sourceMailConnection               MailConnection      @relation(fields: [sourceMailConnectionId], references: [id], onDelete: Restrict)
  acknowledgedByUser                 User?               @relation("AlertAcknowledgedByUser", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  acknowledgedByNotificationMember   NotificationMember? @relation("AlertAcknowledgedByNotificationMember", fields: [acknowledgedByNotificationMemberId], references: [id], onDelete: SetNull)
  recipients                         AlertRecipient[]

  @@unique([sourceMailConnectionId, sourceEventId])
  @@index([teamId, status, detectedAt])
  @@map("alerts")
}

model AlertRecipient {
  id                   String               @id @default(uuid()) @db.Uuid
  alertId              String               @db.Uuid
  kind                 AlertRecipientKind
  userId               String?              @db.Uuid
  notificationMemberId String?              @db.Uuid
  channel              AlertDeliveryChannel @default(IN_APP)
  status               AlertRecipientStatus @default(PENDING)
  acknowledgedAt       DateTime?            @db.Timestamptz(3)
  createdAt            DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @db.Timestamptz(3)
  alert                Alert                @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationMember   NotificationMember?  @relation(fields: [notificationMemberId], references: [id], onDelete: Cascade)

  @@unique([alertId, userId, channel])
  @@unique([alertId, notificationMemberId, channel])
  @@index([userId, status, createdAt])
  @@index([notificationMemberId, status, createdAt])
  @@map("alert_recipients")
}

model UserNotification {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  feedbackId String?              @unique @db.Uuid
  type       UserNotificationType
  title      String               @db.VarChar(160)
  message    String               @db.Text
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)
  readAt     DateTime?            @db.Timestamptz(3)
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback   FeedbackSubmission?  @relation("FeedbackReplyNotification", fields: [feedbackId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("user_notifications")
}

model FeedbackSubmission {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  teamId            String?           @db.Uuid
  message           String            @db.Text
  status            FeedbackStatus    @default(SUBMITTED)
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  repliedAt         DateTime?         @db.Timestamptz(3)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  replyNotification UserNotification? @relation("FeedbackReplyNotification")

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@index([status, createdAt])
  @@map("feedback_submissions")
}

model OwnerTransfer {
  id                  String              @id @default(uuid()) @db.Uuid
  teamId              String              @db.Uuid
  targetMembershipId  String              @db.Uuid
  initiatedByUserId   String              @db.Uuid
  status              OwnerTransferStatus @default(PENDING)
  acceptanceTokenHash String              @unique @db.Char(64)
  expiresAt           DateTime            @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @db.Timestamptz(3)
  acceptedAt          DateTime?           @db.Timestamptz(3)
  canceledAt          DateTime?           @db.Timestamptz(3)
  team                Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  targetMembership    TeamMembership      @relation(fields: [targetMembershipId], references: [id], onDelete: Restrict)
  initiatedByUser     User                @relation(fields: [initiatedByUserId], references: [id], onDelete: Restrict)

  @@index([teamId, status])
  @@map("owner_transfers")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  teamId      String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String   @db.VarChar(100)
  targetType  String?  @db.VarChar(80)
  targetId    String?  @db.VarChar(100)
  requestId   String?  @db.VarChar(100)
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  team        Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model SecurityThrottle {
  keyHash         String    @id @db.Char(64)
  scope           String    @db.VarChar(50)
  failureCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  lockedUntil     DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([scope, lockedUntil])
  @@map("security_throttles")
}
