{
  "name": "@call-now/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:postgres": "RUN_POSTGRES_TESTS=true vitest run tests/postgres-concurrency.integration.test.ts --maxWorkers=1",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/type-provider-typebox": "5.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sinclair/typebox": "0.34.52",
    "argon2": "0.45.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "google-auth-library": "11.0.2",
    "nodemailer": "9.0.5",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.6",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
